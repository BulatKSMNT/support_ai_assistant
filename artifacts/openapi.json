          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 20,
            "title": "Text"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
