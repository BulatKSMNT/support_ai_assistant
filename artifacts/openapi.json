          "id",
          "source_key",
          "title",
          "source_url",
          "version",
          "content_hash",
          "chunk_count",
          "created_at",
          "updated_at"
        ],
        "title": "DocumentInfo"
      },
      "DocumentInput": {
        "properties": {
          "source_key": {
            "type": "string",
